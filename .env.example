# Daftar email yang boleh masuk, dipisah koma. Wajib.
SAKU_ALLOWED_EMAILS=your-email@example.com

# Lokasi database SQLite. Disarankan di luar repo, mis. /var/lib/saku/saku.db
SAKU_DB_PATH=/var/lib/saku/saku.db

# Lokasi penyimpanan struk. Disarankan di luar repo, mis. /var/lib/saku/receipts
SAKU_FILES_DIR=/var/lib/saku/receipts

# Catatan: akun dibuat dari terminal, bukan dari web:
#   node scripts/saku-user.mjs add your-email@example.com "Nama Kamu"
